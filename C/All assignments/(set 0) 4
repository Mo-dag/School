#include <stdio.h>

int main()
{
    int x = 11;
    int y = 6;
    int sum;
    
    // Printing the sum of x and y using a third variable
    sum = x + y;
    printf("x + y = %d\n", sum);
    
    // Printing the difference without using an extra variable 
    printf("x - y = %d\n", x - y);
    
    printf("x * y = %d\n", x*y);
    printf("x / y = %d\n", x/y);
}
